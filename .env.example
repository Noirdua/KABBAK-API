# KABBAK API environment. Copy to `.env` and edit. Never commit `.env`.

# --- Trial signup -----------------------------------------------------------

# Public base URL of THIS API, used inside verification links.
# Include /api/v1. Leave blank to derive it from the incoming request
# (fine behind a correct reverse proxy that forwards the Host header).
# KABBAK_PUBLIC_API_URL=https://api.example.com/api/v1

# KABBAK_SIGNUP_ENABLED=1
# KABBAK_TRIAL_DAYS=30
# KABBAK_TRIAL_ACCESS_LEVEL=premium

# Stable HMAC secret for captcha and verification tokens. If unset, one is
# generated to storage/config/auth-secret.json.
# KABBAK_AUTH_SECRET=

# --- SMTP (email verification) ----------------------------------------------

# Option A: a single URL (nodemailer parses it). `smtps://` = implicit TLS.
# KABBAK_SMTP_URL=smtps://no-reply@example.com:your-app-password@smtp.example.com:465

# Option B: discrete settings (shown commented so it is not half-configured).
# KABBAK_SMTP_HOST=smtp.example.com
# KABBAK_SMTP_PORT=587
# KABBAK_SMTP_SECURE=0
# KABBAK_SMTP_USER=no-reply@example.com
# KABBAK_SMTP_PASS=your-app-password
# KABBAK_MAIL_FROM="KABBAK <no-reply@example.com>"

# While SMTP is unset, the verification code is logged and returned as `devCode`
# so signup can be tested. Once SMTP is configured this turns off automatically.
# KABBAK_EMAIL_DEV_FALLBACK=1

# --- Optional ---------------------------------------------------------------

# KABBAK_BROWSER_TITLE=KABBAK
# HOST=0.0.0.0
# PORT=3100
# KABBAK_ALLOWED_ORIGINS=https://app.example.com
