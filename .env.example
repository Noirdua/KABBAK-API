PORT=3100
# Bind address. Default is 127.0.0.1. Use 0.0.0.0 to listen on all interfaces.
# HOST=127.0.0.1

# Set to 1 (or a hop count) when the API sits behind a reverse proxy.
# KABBAK_TRUST_PROXY=1

# Public demo login key. Off unless this is 1, or the request is from loopback.
# KABBAK_DEMO_ACCESS=0

# Authentication — choose one level (or skip auth entirely with KABBAK_NO_AUTH=1):
KABBAK_API_KEYS=replace-with-client-alpha-key;replace-with-client-beta-key
# KABBAK_API_KEY=replace-with-single-key
# KABBAK_API_CLIENTS=[{"id":"client-1","accountId":"","key":"my-key","accessLevel":"premium","roles":["reader"],"scopes":["api:read"]}]
#
# The GUI cannot read this file. Paste a key into the connection gate (or
# Settings); the browser remembers it. Create extra users in Admin → Users.
# KABBAK_NO_AUTH=1 or loopback demo access skips the key for local use.

# Skip authentication — all routes open without a key:
# KABBAK_NO_AUTH=1

# CORS — required when the browser is NOT on localhost:
# KABBAK_ALLOWED_ORIGINS=https://app.example.com

# DLC / plugin catalog (required to browse or install packs, decks, plugins):
# KABBAK_DLC_REPO=
# KABBAK_DLC_BRANCH=main
# KABBAK_ALLOW_NULL_ORIGIN=0

# Upload sizes (plugin media/files):
# KABBAK_JSON_BODY_LIMIT=10mb
# KABBAK_MAX_PLUGIN_UPLOAD_MB=50

# Request logging (errors | all | none):
# KABBAK_REQUEST_LOG=errors

# Secret used to encrypt stored profiles:
# KABBAK_PROFILE_ENCRYPTION_SECRET=change-me

# Set to 0 to prevent auto-migration on startup:
# KABBAK_AUTO_MIGRATE=1

# Hydrus Network client API (optional; plugin config.json is the default):
# KABBAK_HYDRUS_ORIGIN=http://localhost:45869
# KABBAK_HYDRUS_API_KEY=

# All of the above (except PORT/HOST) can also be edited live from the Admin
# panel → Server Settings; panel values persist in
# storage/config/runtime-settings.json and win over these env values on boot.
