node_modules/
.env
npm-debug.log*
storage/
TaroTime-api*
tests/
.kilo
imports*
.playwright-mcp
KABBAK.code-workspace
# Decks, texts, and other DLC copies live in KABBAK-DLC / imports — not this repo.
# Hot reload copies them into source/ for the snapshot; never commit those copies.
source/assets/tarot deck/*
!source/assets/tarot deck/.gitkeep
source/assets/tarot deck/decks.json

# Text sources — operator-provided content, registered by source/data/text/library.json.
source/data/text/
source/data/gematria-words-index.json

# Text manifest folders — input files are provided by the operator, not shipped.
source/imports/text/*
!source/imports/text/README.md

# Shared imports drop-folder.
# Only READMEs and .gitkeep are tracked directly — content comes from the DLC
# catalog (npm run dlc -- install) or manual drops.
imports/text/*
!imports/text/README.md
!imports/text/.gitkeep

imports/decks/*
!imports/decks/README.md
!imports/decks/.gitkeep

# DLC catalog checkout — `npm run dlc -- repo <url>` (multiple repos allowed).
# Do not ship a default URL.
imports/dlc/*
!imports/dlc/.gitkeep
temp/*
temp